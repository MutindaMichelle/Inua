erDiagram
    users {
        Integer user_id PK
        Text full_name
        Text email
        Text password_hash
        Text role
        Date created_at
    }
    mentors {
        Integer mentor_id PK
        Integer user_id FK
        Integer experience_years
        Text expertise_area
        Text industry
    }
    mentees {
        Integer mentee_id PK
        Integer user_id FK
        Text institution
        Text career_stage
        Text career_interest
    }
    goals {
        Integer goal_id PK
        Integer mentee_id FK
        Text goal_title
        Integer progress_percentage
    }
    sessions {
        Integer session_id PK
        Integer mentor_id FK
        Integer mentee_id FK
        Date session_date
        Integer duration_minutes
        Decimal career_support_score
        Decimal psychosocial_score
        Text status
    }
    feedback {
        Integer feedback_id PK
        Integer session_id FK
        Decimal communication_score
        Decimal goal_progress
        Decimal overall_rating
    }
    predictions {
        Integer prediction_id PK
        Integer session_id FK
        Text effectiveness_label
        Decimal probability
        Text model_version
    }
    mentor_quality_profiles {
        Integer mentor_id PK
        Decimal aggregate_effectiveness_score
        Integer total_sessions
        Date last_updated
    }

    users ||--o| mentors : "1:1 role extension"
    users ||--o| mentees : "1:1 role extension"
    mentors ||--o{ sessions : "1:N conducts"
    mentees ||--o{ sessions : "1:N attends"
    mentees ||--o{ goals : "1:N sets"
    sessions ||--|| feedback : "1:1 generates"
    sessions ||--|| predictions : "1:1 produces"
    mentors ||--|| mentor_quality_profiles : "1:1 has"
