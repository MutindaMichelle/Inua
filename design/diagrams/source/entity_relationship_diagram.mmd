erDiagram
    USER {
        int user_id PK
        string full_name
        string email
        string password_hash
        string role
        datetime created_at
    }
    MENTEE {
        int mentee_id PK
        int user_id FK
        string career_interest
        string institution
        string academic_level
    }
    MENTOR {
        int mentor_id PK
        int user_id FK
        float experience_years
        string expertise_area
        string industry
        boolean is_verified
    }
    MENTORSHIP_SESSION {
        int session_id PK
        int mentor_id FK
        int mentee_id FK
        datetime session_date
        int duration_minutes
        int interaction_frequency
        float goal_progress_pct
        string status
    }
    FEEDBACK {
        int feedback_id PK
        int session_id FK
        int communication_quality
        int mentee_feedback_score
        string comments
    }
    PREDICTION_RESULT {
        int prediction_id PK
        int session_id FK
        string effectiveness_label
        float confidence_score
        datetime predicted_at
    }
    MENTOR_QUALITY_PROFILE {
        int mentor_id PK
        float aggregate_effectiveness_score
        int total_sessions
        datetime last_update
    }

    USER ||--o| MENTEE : extends
    USER ||--o| MENTOR : extends
    MENTOR ||--o{ MENTORSHIP_SESSION : conducts
    MENTEE ||--o{ MENTORSHIP_SESSION : attends
    MENTORSHIP_SESSION ||--|| FEEDBACK : generates
    MENTORSHIP_SESSION ||--|| PREDICTION_RESULT : produces
    MENTOR ||--|| MENTOR_QUALITY_PROFILE : has
    PREDICTION_RESULT }o--|| MENTOR_QUALITY_PROFILE : "aggregates into"
