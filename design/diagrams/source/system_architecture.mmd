flowchart TB
    subgraph CLIENT["PRESENTATION LAYER"]
        direction LR
        A1["Mentee Dashboard<br/>(React.js)"]
        A2["Mentor Dashboard<br/>(React.js)"]
        A3["Admin Dashboard<br/>(React.js)"]
    end

    subgraph API["APPLICATION LAYER"]
        direction LR
        B1["Auth API<br/>(REST)"]
        B2["Session Management API<br/>(REST)"]
        B3["Feedback API<br/>(REST)"]
        B4["Prediction API<br/>(REST)"]
    end

    subgraph ML["PREDICTIVE MODEL LAYER"]
        direction LR
        C1["Preprocessing Pipeline<br/>(Pandas / NumPy)"]
        C2["XGBoost Classifier"]
        C3["Model Store<br/>(serialized model file)"]
    end

    subgraph DATA["DATA LAYER"]
        direction LR
        D1[("PostgreSQL<br/>users / sessions / feedback")]
        D2[("PostgreSQL<br/>predictions / mentor profiles")]
    end

    A1 --> B1
    A2 --> B1
    A3 --> B1
    A1 --> B2
    A2 --> B2
    A1 --> B3
    A2 --> B3
    A3 --> B4

    B1 --> D1
    B2 --> D1
    B3 --> D1
    B4 --> C1
    C1 --> C2
    C2 --> C3
    C2 --> D2
    B4 --> D2

    D2 -.->|"feedback loop:<br/>historical outcomes<br/>refine baseline"| C1

    classDef clientStyle fill:#F4F5F7,stroke:#1B2A4A,stroke-width:1.5px,color:#1B2A4A
    classDef apiStyle fill:#EDE3CF,stroke:#D9A441,stroke-width:1.5px,color:#1B2A4A
    classDef mlStyle fill:#1B2A4A,stroke:#121D33,stroke-width:1.5px,color:#FFFFFF
    classDef dataStyle fill:#E7EEF0,stroke:#3E7C7C,stroke-width:1.5px,color:#1B2A4A

    class A1,A2,A3 clientStyle
    class B1,B2,B3,B4 apiStyle
    class C1,C2,C3 mlStyle
    class D1,D2 dataStyle
