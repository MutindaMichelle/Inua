# ── U-CS 5 (session-value) Service Configuration ─────────────────────────────
PORT=8000

# Live PostgreSQL connection string (Staging / Render / Railway)
# Format: postgresql://user:password@host:5432/inua_db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/inua_mentorship

# JWT Signing Key (Replace in staging/production environment variables; never commit real secrets)
SECRET_KEY=replace-with-secure-staging-secret-key

# Platform Integration URLs (Configured on Career Mentor OS integration layer)
SESSION_VALUE_SERVICE_URL=http://localhost:8000
SESSION_VALUE_APP_URL=http://localhost:8000/demo/index.html
